# Export these values in your shell/service environment. No .env loader is used.
SMTP_ADDR=0.0.0.0:25
SMTP_DOMAIN=localhost
# Empty accepts recipients in any domain; otherwise comma-separated exact domains.
TRUSTED_DOMAINS=
# starttls = optional upgrade; required = reject MAIL until TLS; off = plaintext.
SMTP_TLS_MODE=starttls
TLS_CERT_FILE=config/localhost.crt
TLS_KEY_FILE=config/localhost.key
SMTP_READ_TIMEOUT=30s
SMTP_WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
# All sizes are bytes. Attachment size is measured after transfer decoding.
MAX_MESSAGE_BYTES=26214400
MAX_RECIPIENTS=50
# Zero prohibits attachments.
MAX_ATTACHMENTS=10
MAX_ATTACHMENT_SIZE=10485760
MAX_MIME_PARTS=1000
# SPF is informational; it does not reject messages based on the SPF result.
SPF_ENABLED=true
SPF_TIMEOUT=5s
